#!/usr/bin/env bash
# Script to configure Nginx with a 301 redirect for /redirect_me

# Exit on error
set -e

# Update package list and install Nginx
sudo apt-get update -y
sudo apt-get install -y nginx

# Configure Nginx default site
bash -c 'cat > /etc/nginx/sites-available/default << "EOF"
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }

    # Redirect /redirect_me to another page
    location /redirect_me {
        return 301 http://rentivunwa250.tech;
    }
}
EOF'

# Restart Nginx to apply changes
sudo service nginx restart
echo -e "\nRedirection setup completed.\n"
