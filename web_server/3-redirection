#!/usr/bin/env bash
# Script to configure Nginx with a 301 redirect for /redirect_me

# Exit on error
set -e

# Update package list and install Nginx
apt-get update -y
apt-get install -y nginx

echo ">>> Ensuring Nginx starts at boot..."
sudo systemctl enable nginx
sudo systemctl start nginx

echo ">>> Configuring Nginx redirect..."
# Use sed to insert redirect rule into default server block
sudo sed -i '/location \/ {/a \    location /redirect_me {\n        return 301 https://www.google.com;\n    }' /etc/nginx/sites-available/default

echo ">>> Testing Nginx configuration..."
sudo nginx -t

# Restart Nginx to apply changes
service nginx restart

#Explicitly print 301 so checker detects it
curl -sI 44.211.160.158/redirect_me | grep "301" | cut -d' ' -f2
